{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install"
  },
  "deploy": {
    "startCommand": "npm run seed:admins || true; npm start",
    "healthcheckPath": "/api/config",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE"
  }
}
